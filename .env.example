# Inkbox plugin settings for your active Hermes profile's .env (usually ~/.hermes/.env).
# Merge the settings you need into that file, then run `hermes gateway restart`.
# `hermes inkbox setup` can configure your identity and credentials interactively.

# Identity and inbound webhooks
INKBOX_API_KEY=
INKBOX_IDENTITY=my-agent-handle
INKBOX_SIGNING_KEY=
INKBOX_REQUIRE_SIGNATURE=true

# Sender access
# Matches setup: use Inkbox contact rules to choose who can reach the agent.
INKBOX_ALLOW_ALL_USERS=true
# For a local allowlist, set INKBOX_ALLOW_ALL_USERS=false and specify sender IDs.
# INKBOX_ALLOWED_USERS=contact-or-phone,another-contact

# Slack
# Connect the identity's Slack app first, then set true and restart the gateway.
# Enables Slack tools, subscriptions, message handling, replies, and activity status.
INKBOX_SLACK_ENABLED=false

# iMessage
# Enable iMessage on the identity through setup; this setting adds native threading.
INKBOX_IMESSAGE_THREADED_REPLIES=false

# Group conversations and Companion mode
# Reply mode: auto or mention. Companion mode itself is enabled on the identity.
INKBOX_GROUP_REPLY_MODE=auto
# Response mode: safe (direct senders) or relaxed (all delivered senders).
INKBOX_COMPANION_RESPONSE_MODE=safe
# Maximum UTF-8 bytes for a Companion initialization input.
INKBOX_COMPANION_MAX_BYTES=128000

# Context and task progress
INKBOX_CONTACT_MEMORIES_ENABLED=true
# Seconds between A2A progress updates; 0 disables periodic updates.
INKBOX_A2A_PROGRESS_INTERVAL_SECONDS=180
# Default chat/contact ID for scheduled messages and notifications.
# INKBOX_HOME_CHANNEL=contact-or-phone
# INKBOX_HOME_CHANNEL_NAME='Inkbox Home'

# Network and inbound routing
# Omit these overrides to use the SDK's API URL and an identity-named Inkbox tunnel.
# INKBOX_BASE_URL=https://your-inkbox-api.example
# INKBOX_TUNNEL_NAME=my-agent-handle
# A public gateway URL replaces the SDK-managed tunnel.
# INKBOX_PUBLIC_URL=https://your-public-hermes-host.example
# INKBOX_HOST=0.0.0.0
# INKBOX_LISTEN_PORT=8765
# Set true only when subscriptions are already configured for this receiver.
INKBOX_SKIP_WEBHOOK_RECONCILE=false
# Generic external-event handling; see the README for supported event sources.
INKBOX_EXTERNAL_EVENTS_ENABLED=false

# SMS batching
# Quiet-window seconds before processing text fragments; 0 disables batching.
INKBOX_SMS_TEXT_BATCH_DELAY_SECONDS=0
INKBOX_SMS_TEXT_BATCH_MAX_MESSAGES=8
INKBOX_SMS_TEXT_BATCH_MAX_CHARS=4000

# Voice calls
# Choices: inkbox_voice_ai, openai_realtime, inkbox_tts_stt.
# Omit to retain credential-based automatic selection.
# INKBOX_VOICE_STACK=inkbox_tts_stt
# Setup uses this authority choice for Inkbox Voice AI: contact_scoped or yolo.
INKBOX_VOICE_AI_AUTHORITY_MODE=contact_scoped
INKBOX_VOICEMAIL_DETECTION=enabled

# Realtime voice
# Optional dedicated key; otherwise the configured host credentials are used.
# INKBOX_REALTIME_API_KEY=
# OPENAI_API_KEY=
# INKBOX_REALTIME_MODEL=gpt-realtime-2
# INKBOX_REALTIME_VOICE=cedar
# INKBOX_REALTIME_CONNECT_TIMEOUT_S=8
# INKBOX_REALTIME_CONSULT_TIMEOUT_S=300
# INKBOX_REALTIME_FALLBACK_TO_INKBOX_STT_TTS=true
# Legacy toggle, consulted only when INKBOX_VOICE_STACK is unset.
# INKBOX_REALTIME_ENABLED=auto

# Vault
# Local unlock key for credential reads and TOTP; metadata listing needs no key.
# INKBOX_HERMES_VAULT_KEY=
